@{
    ViewData["Title"] = "Sobre";
}

<div class="about-page">

    <!-- HERO -->
    <section class="about-hero">
        <div class="container-fluid px-5">
            <div class="row align-items-center min-vh-50">

                <div class="col-lg-7">
                    <span class="about-badge">
                        <i class="bi bi-stars"></i> Conheça o TechChallenge
                    </span>

                    <h1 class="about-title">
                        Transformando <span>ideias</span> em projetos.
                    </h1>

                    <p class="about-subtitle">
                        O TechChallenge é uma plataforma criada para facilitar a
                        organização, acompanhamento e desenvolvimento de projetos
                        estudantis.
                    </p>

                    <div class="about-buttons">
                        <a href="/Home" class="btn btn-light btn-lg px-4">
                            <i class="bi bi-house"></i> Voltar ao início
                        </a>

                        <a href="/Projetos" class="btn btn-outline-light btn-lg px-4">
                            Ver projetos <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>

                <div class="col-lg-5 text-center mt-5 mt-lg-0">
                    <div class="about-icon-card">
                        <i class="bi bi-lightbulb"></i>
                        <div class="floating-icon icon-one">
                            <i class="bi bi-code-slash"></i>
                        </div>
                        <div class="floating-icon icon-two">
                            <i class="bi bi-people"></i>
                        </div>
                        <div class="floating-icon icon-three">
                            <i class="bi bi-trophy"></i>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>


    <!-- SOBRE A PLATAFORMA -->
    <section class="about-section bg-white">
        <div class="container-fluid px-5">

            <div class="text-center mb-5">
                <span class="section-label">SOBRE A PLATAFORMA</span>
                <h2>Um espaço para criar, colaborar e evoluir.</h2>
                <p class="section-description">
                    O TechChallenge reúne ferramentas e informações para tornar
                    o desenvolvimento de projetos estudantis mais organizado.
                </p>
            </div>

            <div class="row g-4">

                <div class="col-md-4">
                    <div class="about-card">
                        <div class="card-icon">
                            <i class="bi bi-kanban"></i>
                        </div>

                        <h3>Organização</h3>

                        <p>
                            Tenha uma visão mais clara dos projetos, equipes,
                            categorias e etapas de desenvolvimento.
                        </p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="about-card">
                        <div class="card-icon">
                            <i class="bi bi-people"></i>
                        </div>

                        <h3>Colaboração</h3>

                        <p>
                            Facilite o trabalho em equipe conectando alunos,
                            professores e projetos em um único ambiente.
                        </p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="about-card">
                        <div class="card-icon">
                            <i class="bi bi-rocket-takeoff"></i>
                        </div>

                        <h3>Inovação</h3>

                        <p>
                            Incentive novas ideias e dê espaço para que projetos
                            estudantis possam crescer e ganhar destaque.
                        </p>
                    </div>
                </div>

            </div>
        </div>
    </section>


    <!-- DESTAQUE -->
    <section class="about-highlight">
        <div class="container-fluid px-5">
            <div class="row align-items-center">

                <div class="col-lg-8">
                    <span class="section-label light">NOSSO OBJETIVO</span>

                    <h2>
                        Dar vida às ideias que surgem dentro da escola.
                    </h2>

                    <p>
                        Mais do que uma plataforma de gerenciamento, o
                        TechChallenge busca aproximar alunos e professores,
                        incentivar a criatividade e tornar cada projeto uma
                        oportunidade de aprendizado.
                    </p>
                </div>

                <div class="col-lg-4 text-center">
                    <div class="big-number">
                        <i class="bi bi-stars"></i>
                    </div>
                </div>

            </div>
        </div>
    </section>


    <!-- TECNOLOGIA -->
    <section class="about-section bg-white">
        <div class="container-fluid px-5 text-center">

            <span class="section-label">TECHCHALLENGE</span>

            <h2>Feito para projetos estudantis.</h2>

            <p class="section-description mx-auto">
                Da primeira ideia até a apresentação final, o TechChallenge
                foi pensado para centralizar as informações e facilitar a
                jornada de cada projeto.
            </p>

            <div class="about-stats">

                <div>
                    <strong><i class="bi bi-folder2-open"></i></strong>
                    <span>Projetos</span>
                </div>

                <div>
                    <strong><i class="bi bi-person-workspace"></i></strong>
                    <span>Alunos</span>
                </div>

                <div>
                    <strong><i class="bi bi-mortarboard"></i></strong>
                    <span>Professores</span>
                </div>

                <div>
                    <strong><i class="bi bi-diagram-3"></i></strong>
                    <span>Equipes</span>
                </div>

            </div>

        </div>
    </section>

</div>